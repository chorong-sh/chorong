load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "adapter.go",
        "caller.go",
    ],
    importpath = "github.com/chorong-sh/chorong/agentbus/internal/adapter",
    visibility = ["//agentbus:__subpackages__"],
    deps = ["//agentbus/internal/eventlog:go_default_library"],
)

go_test(
    name = "go_default_test",
    srcs = ["adapter_test.go"],
    deps = [
        ":go_default_library",
        "//agentbus/internal/adapter/fake:go_default_library",
        "//agentbus/internal/eventlog:go_default_library",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
