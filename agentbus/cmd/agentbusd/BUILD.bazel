load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "jobs.go",
        "main.go",
        "notify.go",
    ],
    importpath = "github.com/chorong-sh/chorong/agentbus/cmd/agentbusd",
    visibility = ["//visibility:private"],
    deps = [
        "//agentbus/internal/adapter:go_default_library",
        "//agentbus/internal/adapter/herdr:go_default_library",
        "//agentbus/internal/config:go_default_library",
        "//agentbus/internal/daemon:go_default_library",
        "//agentbus/internal/dialog:go_default_library",
        "//agentbus/internal/hibernate:go_default_library",
        "//agentbus/internal/jobs:go_default_library",
        "//agentbus/internal/lastturn:go_default_library",
        "//agentbus/internal/lease:go_default_library",
        "//agentbus/internal/memreport:go_default_library",
        "//agentbus/internal/paths:go_default_library",
        "//decide:go_default_library",
        "//pkg/procinfo:go_default_library",
        "//pkg/version:go_default_library",
        "@org_golang_x_sys//unix:go_default_library",
    ],
)

go_binary(
    name = "agentbusd",
    embed = [":go_default_library"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "go_default_test",
    srcs = [
        "jobs_test.go",
        "main_test.go",
        "notify_test.go",
    ],
    embed = [":go_default_library"],
    deps = [
        "//agentbus/internal/config:go_default_library",
        "//agentbus/internal/daemon:go_default_library",
        "//agentbus/internal/dialog:go_default_library",
        "//agentbus/internal/hibernate:go_default_library",
        "//agentbus/internal/jobs:go_default_library",
        "//agentbus/internal/lease:go_default_library",
        "//agentbus/internal/paths:go_default_library",
    ],
)

exports_files(
    ["main.go"],
    visibility = ["//:__pkg__"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
