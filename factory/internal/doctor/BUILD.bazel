load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "checks.go",
        "cycle.go",
        "doctor.go",
        "format.go",
        "invert.go",
        "parent.go",
        "trust.go",
    ],
    importpath = "github.com/chorong-sh/chorong/factory/internal/doctor",
    visibility = ["//factory:__subpackages__"],
    deps = [
        "//factory/internal/config:go_default_library",
        "//factory/internal/gh:go_default_library",
        "//factory/internal/herdr:go_default_library",
        "//factory/internal/parentclose:go_default_library",
        "//factory/internal/priority:go_default_library",
        "//factory/internal/ready:go_default_library",
        "//factory/internal/source:go_default_library",
        "//factory/internal/store:go_default_library",
        "@in_gopkg_yaml_v3//:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = [
        "cycle_test.go",
        "defer_test.go",
        "doctor_test.go",
        "false_warn_test.go",
        "invert_test.go",
        "parent_test.go",
        "trust_test.go",
    ],
    data = glob(["*.go"]),
    embed = [":go_default_library"],
    deps = [
        "//factory/internal/config:go_default_library",
        "//factory/internal/gh:go_default_library",
        "//factory/internal/herdr:go_default_library",
        "//factory/internal/ready:go_default_library",
        "//factory/internal/source:go_default_library",
        "//factory/internal/store:go_default_library",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
