load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = ["rank.go"],
    importpath = "github.com/chorong-sh/chorong/factory/internal/rank",
    visibility = ["//factory:__subpackages__"],
    deps = ["//factory/internal/source:go_default_library"],
)

go_test(
    name = "go_default_test",
    srcs = ["rank_test.go"],
    embed = [":go_default_library"],
    deps = ["//factory/internal/source:go_default_library"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
