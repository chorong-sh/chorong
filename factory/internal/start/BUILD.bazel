        "github_status_test.go",
        "lease_test.go",
        "ready_test.go",
        "reportback_test.go",
        "start_prompt_append_test.go",
        "start_test.go",
        "trust_test.go",
        "wake_test.go",
        "worker_test.go",
    ],
    embed = [":go_default_library"],
    deps = [
        "//factory/internal/agentbus:go_default_library",
        "//factory/internal/config:go_default_library",
        "//factory/internal/gate:go_default_library",
        "//factory/internal/herdr:go_default_library",
        "//factory/internal/ready:go_default_library",
        "//factory/internal/source:go_default_library",
        "//factory/internal/source/fake:go_default_library",
        "//factory/internal/store:go_default_library",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
