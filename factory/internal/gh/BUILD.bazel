load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "client.go",
        "decode.go",
        "fields.go",
        "match.go",
        "ref.go",
        "repo.go",
        "status.go",
        "trust.go",
        "types.go",
        "view.go",
    ],
    importpath = "github.com/chorong-sh/chorong/factory/internal/gh",
    visibility = ["//factory:__subpackages__"],
    deps = [
        "//factory/internal/source:go_default_library",
        "//factory/internal/store:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = [
        "client_test.go",
        "fields_test.go",
        "match_test.go",
        "repo_test.go",
        "status_test.go",
        "trust_test.go",
        "view_test.go",
    ],
    embed = [":go_default_library"],
    deps = [
        "//factory/internal/source:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
