load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "enqueue.go",
        "housekeeping.go",
        "lanes.go",
        "pick.go",
        "run.go",
        "settle.go",
        "tick.go",
    ],
    importpath = "github.com/chorong-sh/chorong/factory/internal/tick",
    visibility = ["//factory:__subpackages__"],
    deps = [
        "//factory/internal/agentbus:go_default_library",
        "//factory/internal/backlog:go_default_library",
        "//factory/internal/config:go_default_library",
        "//factory/internal/gate:go_default_library",
        "//factory/internal/gh:go_default_library",
        "//factory/internal/herdr:go_default_library",
        "//factory/internal/prlog:go_default_library",
        "//factory/internal/rank:go_default_library",
        "//factory/internal/ready:go_default_library",
        "//factory/internal/source:go_default_library",
        "//factory/internal/start:go_default_library",
        "//factory/internal/store:go_default_library",
        "//factory/internal/syncer:go_default_library",
        "//factory/internal/verify:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = [
        "enqueue_test.go",
        "lanes_test.go",
        "lease_gate_test.go",
        "record_test.go",
        "settle_test.go",
        "tick_test.go",
        "worker_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":go_default_library"],
    deps = [
        "//factory/internal/agentbus:go_default_library",
        "//factory/internal/config:go_default_library",
        "//factory/internal/gh:go_default_library",
        "//factory/internal/herdr:go_default_library",
        "//factory/internal/source:go_default_library",
        "//factory/internal/start:go_default_library",
        "//factory/internal/store:go_default_library",
        "//factory/internal/verify:go_default_library",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
