load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "approvals.go",
        "backlog.go",
        "claims.go",
        "external.go",
        "finished.go",
        "items.go",
        "prs.go",
        "runs.go",
        "schema.go",
        "store.go",
    ],
    importpath = "github.com/chorong-sh/chorong/factory/internal/store",
    visibility = ["//factory:__subpackages__"],
    deps = [
        "//factory/internal/config:go_default_library",
        "//factory/internal/source:go_default_library",
        "//pkg/sqlitedb:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = [
        "claim_meta_test.go",
        "external_test.go",
        "history_test.go",
        "lane_test.go",
        "pragma_test.go",
        "store_test.go",
    ],
    embed = [":go_default_library"],
    deps = [
        "//factory/internal/config:go_default_library",
        "//factory/internal/source:go_default_library",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
