load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "client.go",
        "opentab.go",
        "process.go",
        "types.go",
    ],
    importpath = "github.com/chorong-sh/chorong/prsync/internal/herdr",
    visibility = ["//prsync:__subpackages__"],
    deps = [
        "//pkg/remotecall:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = [
        "client_test.go",
        "process_test.go",
        "remote_test.go",
    ],
    embed = [":go_default_library"],
    deps = [
        "//pkg/herdrtest:go_default_library",
        "//pkg/remotecall:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
