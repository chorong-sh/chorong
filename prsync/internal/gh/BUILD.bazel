load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "bot_rereview.go",
        "budget.go",
        "client.go",
        "openpr.go",
        "rebase.go",
        "retry.go",
        "teamcover.go",
        "types.go",
        "waive.go",
    ],
    importpath = "github.com/chorong-sh/chorong/prsync/internal/gh",
    visibility = ["//prsync:__subpackages__"],
    deps = [
        "//pkg/ghcli:go_default_library",
        "//pkg/ghlimit:go_default_library",
        "//prsync/internal/runlog:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = [
        "apimethod_test.go",
        "bot_rereview_test.go",
        "client_test.go",
        "cost_test.go",
        "labels_test.go",
        "rebase_test.go",
        "rollup_ttl_test.go",
        "teamcover_budget_test.go",
        "teamcover_split_test.go",
        "teamcover_test.go",
        "waive_test.go",
    ],
    data = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    embed = [":go_default_library"],
    deps = [
        "//pkg/ghlimit:go_default_library",
        "//prsync/internal/roundcache:go_default_library",
        "//prsync/internal/runlog:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
