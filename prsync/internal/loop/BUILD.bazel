load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "blocked.go",
        "doctor.go",
        "ensure.go",
        "gate.go",
        "heartbeat.go",
        "judgment.go",
        "lock.go",
        "loop.go",
    ],
    importpath = "github.com/chorong-sh/chorong/prsync/internal/loop",
    visibility = ["//prsync:__subpackages__"],
    deps = [
        "//prsync/internal/config:go_default_library",
        "//prsync/internal/dispatch:go_default_library",
        "//prsync/internal/ledger:go_default_library",
        "//prsync/internal/policy:go_default_library",
        "//prsync/internal/runlog:go_default_library",
        "//prsync/internal/scan:go_default_library",
        "@com_github_google_renameio_v2//:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
        "@org_golang_x_sys//unix:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = [
        "gate_test.go",
        "judgment_test.go",
        "loop_test.go",
    ],
    embed = [":go_default_library"],
    deps = [
        "//prsync/internal/config:go_default_library",
        "//prsync/internal/dispatch:go_default_library",
        "//prsync/internal/ledger:go_default_library",
        "//prsync/internal/policy:go_default_library",
        "//prsync/internal/runlog:go_default_library",
        "//prsync/internal/scan:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
