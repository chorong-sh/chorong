load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "go_default_library",
    srcs = [
        "jobs.go",
        "owners.go",
        "queue.go",
    ],
    importpath = "github.com/chorong-sh/chorong/prsync/internal/jobs",
    visibility = ["//prsync:__subpackages__"],
    deps = [
        "//prsync/internal/config:go_default_library",
        "//prsync/internal/dispatch:go_default_library",
        "//prsync/internal/scan:go_default_library",
        "@com_github_google_renameio_v2//:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
    ],
)

go_test(
    name = "go_default_test",
    srcs = ["jobs_test.go"],
    data = glob(["testdata/**"]),
    embed = [":go_default_library"],
    deps = [
        "//prsync/internal/config:go_default_library",
        "//prsync/internal/scan:go_default_library",
        "@com_github_jaeyeom_go_cmdexec//:go_default_library",
    ],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
