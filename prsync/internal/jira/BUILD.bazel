load("@rules_go//go:def.bzl", "go_library")

go_library(
    name = "go_default_library",
    srcs = [
        "client.go",
        "issue.go",
    ],
    importpath = "github.com/chorong-sh/chorong/prsync/internal/jira",
    visibility = ["//prsync:__subpackages__"],
    deps = ["@com_github_jaeyeom_go_cmdexec//:go_default_library"],
)

filegroup(
    name = "go_srcs",
    srcs = glob(
        ["**/*.go"],
        exclude = ["**/*_test.go"],
    ),
    visibility = ["//tools/lint:__pkg__"],
)
