load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@nogo_analyzer_bzlmod//:def.bzl", "ANALYZERS", "staticcheck_analyzers")
load("@rules_go//go:def.bzl", "TOOLS_NOGO", "go_test", "nogo")
load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":linters.bzl", "shellcheck_test")

package(default_visibility = ["//:__subpackages__"])

bool_flag(
    name = "skip_nogo",
    build_setting_default = False,
)

config_setting(
    name = "skip_nogo_enabled",
    flag_values = {":skip_nogo": "True"},
)

exports_files([
    "linters.bzl",
])

ADDITIONAL_GOVET = [
    "@org_golang_x_tools//go/analysis/passes/unusedwrite:go_default_library",
]

EXTRA_ANALYZERS = [
    "@com_github_gordonklaus_ineffassign//pkg/ineffassign:go_default_library",
    "@com_github_jaeyeom_godernize//oserrors:go_default_library",
    "@com_github_securego_gosec_v2//goanalysis:go_default_library",
    "@com_github_uudashr_iface//identical:go_default_library",
    "@com_github_uudashr_iface//opaque:go_default_library",
    "@com_github_uudashr_iface//unexported:go_default_library",
    "@com_github_uudashr_iface//unused:go_default_library",
]

nogo(
    name = "platform_nogo",
    config = "nogo.json",
    visibility = ["//visibility:public"],
    deps = select({
        ":skip_nogo_enabled": [],
        "//conditions:default": TOOLS_NOGO + ADDITIONAL_GOVET + EXTRA_ANALYZERS + staticcheck_analyzers(ANALYZERS),
    }),
)

config_setting(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "osx_aarch64",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "osx_x86_64",
    constraint_values = [
        "@platforms//os:osx",
        "@platforms//cpu:x86_64",
    ],
)

_GITLEAKS_COMPATIBLE = select({
    "@platforms//os:linux": [],
    "@platforms//os:osx": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

alias(
    name = "gitleaks_bin",
    actual = select({
        ":linux_aarch64": "@gitleaks_linux_aarch64//:gitleaks",
        ":linux_x86_64": "@gitleaks_linux_x86_64//:gitleaks",
        ":osx_aarch64": "@gitleaks_osx_aarch64//:gitleaks",
        ":osx_x86_64": "@gitleaks_osx_x86_64//:gitleaks",
    }),
    target_compatible_with = _GITLEAKS_COMPATIBLE,
)

sh_test(
    name = "gitleaks_test",
    size = "small",
    srcs = ["gitleaks_test.sh"],
    args = [
        "$(rootpath :gitleaks_bin)",
        "$(rootpath //:.gitleaks.toml)",
        "$(rootpath //:go.mod)",
    ],
    data = [
        ":gitleaks_bin",
        "//:.gitleaks.toml",
        "//:go.mod",
    ],
    tags = [
        "external",
        "local",
    ],
    target_compatible_with = _GITLEAKS_COMPATIBLE,
)

sh_test(
    name = "docsync_test",
    size = "small",
    srcs = ["docsync_test.sh"],
    args = [
        "$(rootpath //docsync/cmd/docsync)",
        "$(rootpath //:go.mod)",
    ],
    data = [
        "//:docsync.yml",
        "//:go.mod",
        "//docsync/cmd/docsync",
    ],
    tags = [
        "external",
        "local",
    ],
)

go_test(
    name = "go_default_test",
    size = "small",
    srcs = [
        "bazel_go_files_test.go",
        "release_config_test.go",
    ],
    data = [
        "//:.goreleaser.yaml",
        "//:.release-please-manifest.json",
        "//:CHANGELOG.md",
        "//.github:workflows/bazel-test.yml",
        "//.github:workflows/release.yml",
        "//.github:workflows/strip-pr-html-comments.yml",
        "//:go.mod",
        "//:release-please-config.json",
    ],
    tags = [
        "external",
        "local",
    ],
    deps = ["@in_gopkg_yaml_v3//:go_default_library"],
)

filegroup(
    name = "sh_srcs",
    srcs = glob(["*.sh"]),
)

sh_library(
    name = "repo_sh_srcs",
    srcs = [
        ":sh_srcs",
        "//.githooks:sh_srcs",
        "//:sh_srcs",
        "//decide/contrib/panels:sh_srcs",
        "//decide/web:sh_srcs",
        "//docsync/internal/cli:sh_srcs",
        "//genfiles/cmd/genfiles:sh_srcs",
        "//gh-ask/userscript:sh_srcs",
        "//gh-nudge:sh_srcs",
        "//gh-nudge/internal/config/pkl:sh_srcs",
        "//prsync/internal/cli:sh_srcs",
        "//prsync/internal/scan:sh_srcs",
        "//tools/format:sh_srcs",
    ],
)

shellcheck_test(
    name = "shellcheck_test",
    size = "small",
    srcs = [":repo_sh_srcs"],
)

sh_test(
    name = "shellcheck_config_test",
    size = "small",
    srcs = ["shellcheck_config_test.sh"],
    args = [
        "$(rootpath @aspect_rules_lint//lint:shellcheck_bin)",
        "$(rootpath //:.shellcheckrc)",
    ],
    data = [
        "//:.shellcheckrc",
        "@aspect_rules_lint//lint:shellcheck_bin",
    ],
)
